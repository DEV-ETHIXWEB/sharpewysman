# Public URL of this Next.js site (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://sharpewysman.com

# Headless WordPress (where the sharpe-wysman-headless plugin is installed)
WORDPRESS_URL=https://cms.sharpewysman.com

# Seconds before cached WordPress content is refreshed (WordPress also triggers instant refreshes)
WP_REVALIDATE_SECONDS=600

# Shared secrets: must match SW_REVALIDATE_SECRET and SW_FORMS_SECRET in wp-config.php
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
WP_FORMS_SECRET=

# Optional
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
